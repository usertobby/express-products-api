              "pm.test('returns 400', function () { pm.response.to.have.status(400); });",
              "pm.test('returns validation message', function () {",
              "  pm.expect(pm.response.json().message).to.eql('Nama dan harga produk tidak valid');",
              "});"
            ]
          }
        }
      ]
    },
    {
