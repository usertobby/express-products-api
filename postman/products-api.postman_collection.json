            ]
          }
        }
      ]
    },
    {
      "name": "07 - PUT update created product",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{createdProductId}},\n  \"name\": \"Produk Postman Diubah\",\n  \"price\": 15000\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/products" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns updated values', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('createdProductId'));",
              "  pm.expect(body.name).to.eql('Produk Postman Diubah');",
              "  pm.expect(body.price).to.eql(15000);",
              "});"
            ]
          }
        }
      ]
    },
